# Copy this file to .env for local builds. .env is ignored by git.
# In CI the same names come from the repository's Actions secrets instead.

# Last.fm API key, for the "Recently played" list on the home page. The
# build passes it to static/site.js, which fetches the tracks in the browser.
# Create one at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# GitHub token, for the pinned repositories ("Projects") on the home page.
# GitHub only shares pins through its GraphQL API, which needs a token; any
# token works, it needs no extra permissions. With the GitHub CLI installed,
# `gh auth token` prints one. In CI, GitHub Actions provides it.
GITHUB_TOKEN=
